# Flask Secret Key for session management and CSRF protection
FLASK_SECRET_KEY=your_flask_secret_key_here

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# Admin Login Password Hash (generated via werkzeug.security.generate_password_hash)
ADMIN_PASSWORD_HASH=your_admin_password_hash_here
